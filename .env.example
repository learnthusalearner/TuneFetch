# Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://neondb_owner:password@your-neon-host.neon.tech/neondb?sslmode=require

# Spotify Developer Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Serper API Key (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Security
SESSION_SECRET_KEY=change_this_to_a_secure_random_string
FRONTEND_URL=http://localhost:5173
