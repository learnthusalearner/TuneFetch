# ============================================================
# TuneFetch Backend Environment Configuration
# Copy this file to .env:  cp .env.example .env
# ============================================================

# Database Configuration
# Leave commented out to use local SQLite (zero setup required!):
# DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# Spotify Developer Credentials (REQUIRED for Spotify login & playlists)
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. In your Spotify app settings, add this exact Redirect URI:
#    http://127.0.0.1:8000/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Serper API Key (REQUIRED for YouTube audio stream resolution)
# Get 2,500 free searches on signup at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Session & Frontend Security
SESSION_SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
FRONTEND_URL=http://localhost:5173
