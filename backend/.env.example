# Neon PostgreSQL Database (Optional - leave empty or commented for SQLite)
# DATABASE_URL="postgresql://user:password@ep-sample-host.neon.tech/neondb?sslmode=require"

# Spotify Developer Credentials (REQUIRED)
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:8000/spotify/callback"

# Serper Search API Key (REQUIRED for YouTube audio stream discovery)
SERPER_API_KEY="your_serper_api_key_here"

# Security Session Key
SESSION_SECRET_KEY="change_this_to_a_secure_random_string_at_least_32_chars"
